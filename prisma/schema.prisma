generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  password            String
  avatar              String?
  role                SystemRole           @default(DEVELOPER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  activityLogs        ActivityLog[]
  comments            Comment[]
  uploadedDocuments   Document[]           @relation("DocumentUploader")
  follows             Follow[]
  messages            Message[]
  pokesReceived       PokeRecord[]         @relation("Poked")
  pokesSent           PokeRecord[]         @relation("Poker")
  productMembers      ProductMember[]
  createdProducts     Product[]            @relation("ProductCreator")
  ownedProducts       Product[]            @relation("ProductOwner")
  progressLogs        ProgressLog[]
  projectMembers      ProjectMember[]
  createdProjects     Project[]            @relation("ProjectCreator")
  createdReleases     Release[]            @relation("ReleaseCreator")
  releaseOwner        Release[]            @relation("ReleaseOwner")
  releaseLogs         ReleaseLog[]         @relation("ReleaseLogCreator")
  createdDependencies WorkItemDependency[] @relation("DependencyCreator")
  createdWorkItems    WorkItem[]           @relation("WorkItemCreator")
  devWorkItems        WorkItem[]           @relation("DevOwner")
  testWorkItems       WorkItem[]           @relation("TestOwner")
  verifyWorkItems     WorkItem[]           @relation("VerifyOwner")

  @@map("users")
}

model Product {
  id              String           @id @default(cuid())
  name            String
  code            String           @unique
  description     String?
  status          ProductStatus    @default(ACTIVE)
  ownerId         String
  creatorId       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  starred         Boolean          @default(false)
  documents       Document[]
  modules         Module[]
  members         ProductMember[]
  versions        ProductVersion[]
  creator         User             @relation("ProductCreator", fields: [creatorId], references: [id])
  owner           User             @relation("ProductOwner", fields: [ownerId], references: [id])
  projectProducts ProjectProduct[]
  workItems       WorkItem[]       @relation("ProductWorkItem")

  @@map("products")
}

model Module {
  id          String     @id @default(cuid())
  productId   String
  parentId    String?
  name        String
  description String?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Module?    @relation("ModuleHierarchy", fields: [parentId], references: [id])
  children    Module[]   @relation("ModuleHierarchy")
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  workItems   WorkItem[] @relation("ModuleWorkItem")

  @@map("modules")
}

model Document {
  id         String   @id @default(cuid())
  productId  String
  name       String
  fileName   String
  fileSize   Int
  fileType   String
  filePath   String
  uploaderId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploader   User     @relation("DocumentUploader", fields: [uploaderId], references: [id])

  @@map("documents")
}

model ProductVersion {
  id          String               @id @default(cuid())
  productId   String
  name        String
  description String?
  status      ProductVersionStatus @default(PLANNING)
  plannedDate DateTime?
  releaseDate DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  product     Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  workItems   WorkItem[]           @relation("VersionWorkItem")

  @@map("product_versions")
}

model ProductMember {
  id        String      @id @default(cuid())
  productId String
  userId    String
  role      ProductRole @default(MEMBER)
  joinedAt  DateTime    @default(now())
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@map("product_members")
}

model Project {
  id              String           @id @default(cuid())
  name            String
  code            String           @unique
  description     String?
  status          ProjectStatus    @default(ACTIVE)
  creatorId       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  endDate         DateTime?
  starred         Boolean          @default(false)
  startDate       DateTime?
  phaseConfigs    PhaseConfig[]
  members         ProjectMember[]
  projectProducts ProjectProduct[]
  creator         User             @relation("ProjectCreator", fields: [creatorId], references: [id])
  releases        Release[]
  sprints         Sprint[]
  statusConfigs   StatusConfig[]
  workItems       WorkItem[]       @relation("ProjectWorkItem")

  @@map("projects")
}

model ProjectProduct {
  id        String   @id @default(cuid())
  projectId String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, productId])
  @@map("project_products")
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(DEVELOPER)
  joinedAt  DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Sprint {
  id        String       @id @default(cuid())
  projectId String
  name      String
  goal      String?
  startDate DateTime
  endDate   DateTime
  status    SprintStatus @default(PLANNING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  follows   Follow[]     @relation("SprintFollow")
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItems WorkItem[]

  @@map("sprints")
}

model WorkItem {
  id               String               @id @default(cuid())
  projectId        String?
  sprintId         String?
  parentId         String?
  type             WorkItemType
  title            String
  description      String?
  priority         Priority             @default(P2)
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  estimatedHours   Float?
  actualHours      Float?
  currentPhase     Phase                @default(DEVELOPMENT)
  devStatus        String               @default("NOT_STARTED")
  testStatus       String               @default("NOT_STARTED")
  verifyStatus     String               @default("NOT_STARTED")
  creatorId        String
  devOwnerId       String?
  testOwnerId      String?
  verifyOwnerId    String?
  requireVerify    Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  moduleId         String?
  productId        String?
  requirementType  RequirementType?
  versionId        String?
  activityLogs     ActivityLog[]
  comments         Comment[]
  follows          Follow[]             @relation("WorkItemFollow")
  progressLogs     ProgressLog[]
  releaseItems     ReleaseItem[]
  dependents       WorkItemDependency[] @relation("DependsOnItem")
  dependencies     WorkItemDependency[] @relation("DependentItem")
  creator          User                 @relation("WorkItemCreator", fields: [creatorId], references: [id])
  devOwner         User?                @relation("DevOwner", fields: [devOwnerId], references: [id])
  module           Module?              @relation("ModuleWorkItem", fields: [moduleId], references: [id])
  parent           WorkItem?            @relation("WorkItemHierarchy", fields: [parentId], references: [id])
  children         WorkItem[]           @relation("WorkItemHierarchy")
  product          Product?             @relation("ProductWorkItem", fields: [productId], references: [id])
  project          Project?             @relation("ProjectWorkItem", fields: [projectId], references: [id], onDelete: Cascade)
  sprint           Sprint?              @relation(fields: [sprintId], references: [id])
  testOwner        User?                @relation("TestOwner", fields: [testOwnerId], references: [id])
  verifyOwner      User?                @relation("VerifyOwner", fields: [verifyOwnerId], references: [id])
  version          ProductVersion?      @relation("VersionWorkItem", fields: [versionId], references: [id])

  @@map("work_items")
}

model Release {
  id              String        @id @default(cuid())
  projectId       String
  name            String
  description     String?
  plannedDate     DateTime
  actualDate      DateTime?
  status          ReleaseStatus @default(PLANNING)
  ownerId         String
  creatorId       String
  riskLevel       RiskLevel     @default(LOW)
  riskDescription String?
  aiRiskScore     Float?        // AI风险评分 0-100
  aiRiskAnalysis  Json?         // AI风险分析详情
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           ReleaseItem[]
  logs            ReleaseLog[]
  creator         User          @relation("ReleaseCreator", fields: [creatorId], references: [id])
  owner           User          @relation("ReleaseOwner", fields: [ownerId], references: [id])
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("releases")
}

model ReleaseItem {
  id         String   @id @default(cuid())
  releaseId  String
  workItemId String
  createdAt  DateTime @default(now())
  release    Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([releaseId, workItemId])
  @@map("release_items")
}

model ReleaseLog {
  id          String          @id @default(cuid())
  releaseId   String
  action      ReleaseAction
  description String?
  snapshot    Json?           // 存储发布时的需求快照等数据
  createdById String
  createdAt   DateTime        @default(now())
  release     Release         @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  createdBy   User            @relation("ReleaseLogCreator", fields: [createdById], references: [id])

  @@map("release_logs")
}

model WorkItemDependency {
  id             String         @id @default(cuid())
  workItemId     String
  dependsOnId    String
  dependencyType DependencyType @default(FF)
  createdAt      DateTime       @default(now())
  createdById    String
  pokeRecords    PokeRecord[]
  createdBy      User           @relation("DependencyCreator", fields: [createdById], references: [id])
  dependsOn      WorkItem       @relation("DependsOnItem", fields: [dependsOnId], references: [id], onDelete: Cascade)
  workItem       WorkItem       @relation("DependentItem", fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([workItemId, dependsOnId])
  @@map("work_item_dependencies")
}

model PokeRecord {
  id           String             @id @default(cuid())
  dependencyId String
  pokerId      String
  pokedId      String
  message      String
  createdAt    DateTime           @default(now())
  dependency   WorkItemDependency @relation(fields: [dependencyId], references: [id], onDelete: Cascade)
  poked        User               @relation("Poked", fields: [pokedId], references: [id])
  poker        User               @relation("Poker", fields: [pokerId], references: [id])

  @@map("poke_records")
}

model Comment {
  id         String   @id @default(cuid())
  workItemId String
  userId     String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Follow {
  id         String     @id @default(cuid())
  userId     String
  targetType FollowType
  sprintId   String?
  workItemId String?
  createdAt  DateTime   @default(now())
  sprint     Sprint?    @relation("SprintFollow", fields: [sprintId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItem   WorkItem?  @relation("WorkItemFollow", fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, sprintId, workItemId])
  @@map("follows")
}

model Message {
  id         String      @id @default(cuid())
  userId     String
  type       MessageType
  title      String
  content    String
  targetType String?
  targetId   String?
  isRead     Boolean     @default(false)
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model ActivityLog {
  id         String   @id @default(cuid())
  workItemId String
  userId     String
  action     String
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

model ProgressLog {
  id          String   @id @default(cuid())
  workItemId  String
  userId      String
  date        DateTime @db.Date
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  workItem    WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([workItemId, userId, date])
  @@map("progress_logs")
}

model StatusConfig {
  id           String       @id @default(cuid())
  projectId    String
  workItemType WorkItemType
  name         String
  order        Int          @default(0)
  isDefault    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("status_configs")
}

model PhaseConfig {
  id           String       @id @default(cuid())
  projectId    String
  workItemType WorkItemType
  phase        Phase
  isRequired   Boolean      @default(true)
  order        Int          @default(0)
  createdAt    DateTime     @default(now())
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, workItemType, phase])
  @@map("phase_configs")
}

enum SystemRole {
  ADMIN
  PROJECT_MANAGER
  DEVELOPER
  TESTER
  PRODUCT
}

enum ProductVersionStatus {
  PLANNING
  DEVELOPING
  RELEASED
  ARCHIVED
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum ProductRole {
  OWNER
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectRole {
  MANAGER
  DEVELOPER
  TESTER
  PRODUCT
}

enum SprintStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorkItemType {
  REQUIREMENT
  TASK
  BUG
}

enum RequirementType {
  FEATURE
  OPTIMIZATION
  SECURITY
  TECH
}

enum Priority {
  P0
  P1
  P2
  P3
  P4
}

enum Phase {
  DEVELOPMENT
  TESTING
  VERIFICATION
}

enum ReleaseStatus {
  PLANNING
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum DependencyType {
  FF
}

enum FollowType {
  SPRINT
  WORK_ITEM
}

enum MessageType {
  POKE
  FOLLOW_CHANGE
  OVERDUE
  ASSIGNMENT
  COMMENT
  SYSTEM
}

enum ReleaseAction {
  CREATED           // 创建发布
  UPDATED           // 更新发布
  STATUS_CHANGED    // 状态变更
  ITEMS_ADDED       // 添加需求
  ITEMS_REMOVED     // 移除需求
  RISK_UPDATED      // 风险更新
  CONFIRMED         // 确认发布
  COMPLETED         // 发布完成
  CANCELLED         // 取消发布
  ROLLBACK          // 回滚
}
